<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.sfsoftware</groupId>
    <artifactId>sfsoftware-lwjgl-framework</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>S&amp;F Software LWJGL Framework</name>

    <properties>
        <!-- Preserve the project's existing Java 8 compatibility -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Existing LWJGL version -->
        <lwjgl.version>2.9.1</lwjgl.version>
    </properties>

    <dependencies>

        <!-- LWJGL 2 Core -->
        <dependency>
            <groupId>org.lwjgl.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
            <version>${lwjgl.version}</version>
        </dependency>

        <!-- LWJGL 2 Native Libraries (Linux development target) -->
        <dependency>
            <groupId>org.lwjgl.lwjgl</groupId>
            <artifactId>lwjgl-platform</artifactId>
            <version>${lwjgl.version}</version>
            <classifier>natives-linux</classifier>
            <scope>runtime</scope>
        </dependency>

        <!-- JInput -->
        <dependency>
            <groupId>net.java.jinput</groupId>
            <artifactId>jinput</artifactId>
            <version>2.0.5</version>
        </dependency>

        <!-- JOrbis -->
        <dependency>
            <groupId>com.googlecode.soundlibs</groupId>
            <artifactId>jorbis</artifactId>
            <version>0.0.17-1</version>
        </dependency>

        <!-- JSON-java -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20180813</version>
        </dependency>

        <!--
            slick-util.jar is intentionally not included yet.

            We need to identify its exact origin/version and determine
            whether a Maven artifact can replace it without introducing
            unwanted Slick2D or LWJGL version changes.
        -->
    </dependencies>

    <build>

        <!-- Preserve the existing Eclipse source folder -->
        <sourceDirectory>src</sourceDirectory>

        <!-- Preserve the existing Eclipse output directory for now -->
        <outputDirectory>bin</outputDirectory>

        <plugins>

            <!-- Explicitly use a Java 8-compatible compiler configuration -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                </configuration>
            </plugin>
            
			<plugin>
			    <groupId>org.apache.maven.plugins</groupId>
			    <artifactId>maven-dependency-plugin</artifactId>
			    <version>3.8.1</version>
			    <executions>
			        <execution>
			            <id>unpack-lwjgl-natives</id>
			            <phase>process-resources</phase>
			            <goals>
			                <goal>unpack</goal>
			            </goals>
			            <configuration>
			                <artifactItems>
			                    <artifactItem>
			                        <groupId>org.lwjgl.lwjgl</groupId>
			                        <artifactId>lwjgl-platform</artifactId>
			                        <version>${lwjgl.version}</version>
			                        <classifier>natives-linux</classifier>
			                        <type>jar</type>
			                        <outputDirectory>
			                            ${project.build.directory}/natives
			                        </outputDirectory>
			                    </artifactItem>
			                </artifactItems>
			            </configuration>
			        </execution>
			    </executions>
			</plugin>

        </plugins>

    </build>

</project>
